generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DECLINED
  SUSPENDED
}

enum ActivityAction {
  APPROVE
  DECLINE
  SUSPEND
  REINSTATE
  COURSE_CHANGE
  DELETE
  COURSE_CREATE
  COURSE_UPDATE
  COURSE_DELETE
  MOCKTEST_CREATE
  MOCKTEST_UPDATE
  MOCKTEST_PUBLISH
  MOCKTEST_DELETE
  CONTENT_CREATE
  CONTENT_UPDATE
  CONTENT_DELETE
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
}

model Student {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  passwordHash   String?
  googleId       String?        @unique
  courseId        String
  course          Course         @relation(fields: [courseId], references: [id])
  attempts        Attempt[]
  approvalStatus ApprovalStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([courseId])
}

model Course {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  hasBook     Boolean      @default(false)
  hasMockTest Boolean      @default(false)
  hasVideos   Boolean      @default(false)
  hasNotes    Boolean      @default(false)
  hasNotices  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  students    Student[]
  mockTests   MockTest[]
  videoTopics VideoTopic[]
  noteLinks   NoteLink[]
  notices     Notice[]

  @@map("courses")
}

model VideoTopic {
  id       String  @id @default(cuid())
  courseId String
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name     String
  order    Int
  videos   Video[]

  @@index([courseId])
  @@unique([courseId, order])
}

model Video {
  id           String     @id @default(cuid())
  videoTopicId String
  videoTopic   VideoTopic @relation(fields: [videoTopicId], references: [id], onDelete: Cascade)
  title        String
  url          String
  order        Int

  @@index([videoTopicId])
  @@unique([videoTopicId, order])
}

model NoteLink {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  url       String
  order     Int
  createdAt DateTime @default(now())

  @@index([courseId])
  @@unique([courseId, order])
}

model Notice {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  url       String?
  body      String
  createdAt DateTime @default(now())

  @@index([courseId, createdAt])
}

model MockTest {
  id                     String     @id @default(cuid())
  courseId               String
  course                 Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name                   String
  timeLimitMinutes       Int?
  negativeMarkingPercent Float?
  isPublished            Boolean    @default(false)
  leaderboardHidden      Boolean    @default(false)
  createdAt              DateTime   @default(now())
  sections               Section[]
  attempts               Attempt[]

  @@index([courseId])
}

model Attempt {
  id                   String        @id @default(cuid())
  studentId            String
  student              Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mockTestId           String
  mockTest             MockTest      @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  status               AttemptStatus @default(IN_PROGRESS)
  answers              Json          @default("{}")
  flaggedQuestionIds   Json          @default("[]")
  questionOrder        Json
  startedAt            DateTime      @default(now())
  completedAt          DateTime?
  timeRemainingSeconds Int?
  score                Float?
  maxPossibleScore     Float?

  @@index([studentId, mockTestId, status])
  @@index([mockTestId])
}

model Section {
  id                String     @id @default(cuid())
  mockTestId        String
  mockTest          MockTest   @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  name              String
  pointsPerQuestion Float
  order             Int
  questions         Question[]

  @@index([mockTestId])
  @@unique([mockTestId, order])
}

model Question {
  id                 String  @id @default(cuid())
  sectionId          String
  section            Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  text               String
  options            String[]
  correctOptionIndex Int
  order              Int

  @@index([sectionId])
  @@unique([sectionId, order])
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model BookAsset {
  id         String   @id @default("after-see-book")
  filename   String
  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ActivityLog {
  id           String         @id @default(cuid())
  adminId      String
  adminEmail   String
  action       ActivityAction
  studentId    String?
  studentName  String
  studentEmail String
  createdAt    DateTime       @default(now())

  @@index([createdAt])
}
