generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Course {
  AFTER_SEE
  CLASS_11
  CLASS_12
}
enum ApprovalStatus {
  PENDING
  APPROVED
  DECLINED
  SUSPENDED
}

enum ActivityAction {
  APPROVE
  DECLINE
  SUSPEND
  REINSTATE
  COURSE_CHANGE
  DELETE
}

model Student {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  passwordHash   String?
  googleId       String?        @unique
  selectedCourse Course
  approvalStatus ApprovalStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model BookAsset {
  id         String   @id @default("after-see-book")
  filename   String
  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ActivityLog {
  id           String         @id @default(cuid())
  adminId      String
  adminEmail   String
  action       ActivityAction
  studentId    String?
  studentName  String
  studentEmail String
  createdAt    DateTime       @default(now())

  @@index([createdAt])
}
