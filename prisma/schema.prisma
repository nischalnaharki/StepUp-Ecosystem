generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DECLINED
  SUSPENDED
}

enum ActivityAction {
  APPROVE
  DECLINE
  SUSPEND
  REINSTATE
  COURSE_CHANGE
  DELETE
}

model Student {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  passwordHash   String?
  googleId       String?        @unique
  courseId        String
  course          Course         @relation(fields: [courseId], references: [id])
  approvalStatus ApprovalStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([courseId])
}

model Course {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  hasBook     Boolean   @default(false)
  hasMockTest Boolean   @default(false)
  createdAt   DateTime  @default(now())
  students    Student[]

  @@map("courses")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model BookAsset {
  id         String   @id @default("after-see-book")
  filename   String
  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ActivityLog {
  id           String         @id @default(cuid())
  adminId      String
  adminEmail   String
  action       ActivityAction
  studentId    String?
  studentName  String
  studentEmail String
  createdAt    DateTime       @default(now())

  @@index([createdAt])
}
